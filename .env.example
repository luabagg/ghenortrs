# Environment variables for ghenortrs.
# Copy to .env.local (Vite) and Vercel project settings (server/edge).

# ---------------------------------------------------------------------------
# Public (safe for VITE_*)
# ---------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173
VITE_GHENO_STORE_URL=https://store.ghenortrs.com.br
VITE_B2B_CONTACT_EMAIL=contato@ghenortrs.com.br

# GTM container ID. Empty skips the script. Set in production.
VITE_GTM_ID=

# Supabase browser client. Use anon key only. Never use service role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Default B2B min quantity in UI before catalog loads.
VITE_B2B_DEFAULT_MIN_QUANTITY=6

# Legacy lead endpoint. Fallback when Supabase auth is not set.
# Example: https://ghenortrs.vercel.app/api/b2b-submit
VITE_B2B_SUBMIT_URL=

# ---------------------------------------------------------------------------
# Server / Vercel Edge only (never prefix with VITE_)
# ---------------------------------------------------------------------------
SITE_URL=https://ghenortrs.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: registration alerts, approval emails, quote requests
RESEND_API_KEY=
RESEND_TO_EMAIL=contato@ghenortrs.com.br
# RESEND_FROM=GHENO B2B <noreply@ghenortrs.com.br>

# Long-lived admin secret for header auth only (X-Admin-Secret).
# Used to sign short-lived approval/OAuth tokens. Never put this value in URLs.
# Required for: POST /api/admin-approve-seller (JSON), POST /api/bling-oauth-start,
# POST /api/bling-sync, and signed email approval links.
B2B_ADMIN_APPROVE_SECRET=

# B2B commercial rules
B2B_DEFAULT_MIN_QUANTITY=6

# Bling OAuth app (https://developer.bling.com.br)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Must match the redirect URI on the Bling app:
#   https://ghenortrs.vercel.app/api/bling-oauth-callback
BLING_REDIRECT_URI=https://ghenortrs.vercel.app/api/bling-oauth-callback
# Optional overrides
# BLING_API_BASE=https://api.bling.com.br/Api/v3
# BLING_AUTH_BASE=https://www.bling.com.br/Api/v3/oauth
