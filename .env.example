# Copy to `.env`. `pnpm envPull` overwrites `.env` from Vercel.
# Client only sees `VITE_*`. vite.config maps SUPABASE_URL / SUPABASE_ANON_KEY
# into the client — do not add VITE_SUPABASE_* and never expose SERVICE_ROLE.

# --- Site ---
# Canonical origin (emails, OAuth redirects, absolute URLs). Fallback: VITE_SITE_URL, then http://localhost:5173.
SITE_URL="https://www.ghenortrs.com.br"
VITE_SITE_URL="https://www.ghenortrs.com.br"
# Optional. Google Tag Manager container, e.g. GTM-XXXX.
VITE_GTM_ID=""

# --- Supabase (required) ---
# Auth → URL Configuration must allow /b2b, /b2b/catalogo, and
# /admin/login/callback on this origin (incl. localhost:3000 / localhost:5173),
# or magic links fall back to Site URL (`/?code=`). A `/**` wildcard per origin
# covers all three. See the B2B operations section in README.md.
SUPABASE_URL=""
# Public anon key. Safe on the client.
SUPABASE_ANON_KEY=""
# Server only. Auth admin + privileged API. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""
# Dashboard / Vercel aliases. App reads ANON + SERVICE_ROLE, not these.
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWT_SECRET=""

# --- Database (required) ---
# First non-empty wins: DATABASE_URL, POSTGRES_PRISMA_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING.
# Runtime: transaction pooler (6543). drizzle-kit push: NON_POOLING (5432).
DATABASE_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
# Vercel Postgres split fields. Unused when a full URL above is set.
POSTGRES_DATABASE=""
POSTGRES_HOST=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# --- Resend (B2B cadastro + cotação) ---
# Both key and inbox required to send GHENO alerts. Cadastro still saves without them.
RESEND_API_KEY=""
RESEND_TO_EMAIL=""
# Optional. Default: GHENO B2B <noreply@ghenortrs.com.br>
RESEND_FROM=""
# Resend dashboard domain. App does not read this.
RESEND_EMAIL_DOMAIN="ghenortrs.com.br"

# --- Bling ---
# Empty = "Conectar Bling" in /admin/produtos reports bling_not_configured.
# API/auth bases have defaults in env.ts.
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
BLING_REDIRECT_URI="https://www.ghenortrs.com.br/api/bling-oauth-callback"

# --- Admin / B2B ---
# Signs seller approval links only. Required to approve sellers by email.
B2B_APPROVAL_LINK_SECRET=""
# Comma-separated emails that become admins on first /admin login.
# Used only while admin_users is empty. Example: voce@ghenortrs.com.br
ADMIN_BOOTSTRAP_EMAILS=""
# Catalog default min quantity. Client prefers VITE_*; server reads B2B_*. Default 6.
B2B_DEFAULT_MIN_QUANTITY=""
VITE_B2B_DEFAULT_MIN_QUANTITY="6"

# --- Vercel platform (injected; app does not read) ---
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
VERCEL_OIDC_TOKEN=""
