# Environment variables for ghenortrs.
# Copy this file to .env.local (Vite) and to Vercel project settings (server/edge).

# ---------------------------------------------------------------------------
# Public (safe for VITE_*)
# ---------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173
VITE_GHENO_STORE_URL=https://store.ghenortrs.com.br
VITE_B2B_CONTACT_EMAIL=contato@ghenortrs.com.br

# GTM container ID. An empty value skips the script. Set this value in production.
VITE_GTM_ID=

# Supabase browser client. Use the anon key only. Do not use the service role here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Default B2B min quantity in the UI before the catalog loads.
VITE_B2B_DEFAULT_MIN_QUANTITY=6

# Legacy lead endpoint. Fallback if Supabase auth is not set.
# Example: https://ghenortrs.vercel.app/api/b2b-submit
VITE_B2B_SUBMIT_URL=

# ---------------------------------------------------------------------------
# Server / Vercel Edge only (do not add the VITE_ prefix)
# ---------------------------------------------------------------------------
SITE_URL=https://ghenortrs.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for Drizzle. Use the Supabase transaction pooler URI (port 6543)
# with the database password, not the anon/service JWT. Example:
#   postgres://postgres.PROJECT:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Resend: registration alerts, approval emails, quote requests
RESEND_API_KEY=
RESEND_TO_EMAIL=contato@ghenortrs.com.br
# RESEND_FROM=GHENO B2B <noreply@ghenortrs.com.br>

# Long-lived admin secret for header auth only (X-Admin-Secret).
# This secret signs short-lived approval/OAuth tokens. Do not put this value in URLs.
# Required for: POST /api/admin-approve-seller (JSON), POST /api/bling-oauth-start,
# POST /api/bling-sync, and signed email approval links.
B2B_ADMIN_APPROVE_SECRET=

# B2B commercial rules
B2B_DEFAULT_MIN_QUANTITY=6

# Bling OAuth app (https://developer.bling.com.br)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Set this value to the redirect URI on the Bling app:
#   https://ghenortrs.vercel.app/api/bling-oauth-callback
BLING_REDIRECT_URI=https://ghenortrs.vercel.app/api/bling-oauth-callback
# Optional overrides
# BLING_API_BASE=https://api.bling.com.br/Api/v3
# BLING_AUTH_BASE=https://www.bling.com.br/Api/v3/oauth
