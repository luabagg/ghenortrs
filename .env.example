# Environment variables for ghenortrs.
# Copy to .env.local and fill in real values before deploying.

VITE_SITE_URL=http://localhost:5173
VITE_GHENO_STORE_URL=https://example.com
VITE_B2B_CONTACT_EMAIL=contato@example.com

# LUA-29: B2B lead-capture form submission endpoint (serverless function URL).
# When unset, the form falls back to the WhatsApp contact link.
# Example (Vercel): https://ghenortrs.vercel.app/api/b2b-submit
VITE_B2B_SUBMIT_URL=
