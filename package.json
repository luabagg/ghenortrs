    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"{package,components}.json\" \"{README,DESIGN}.md\" \"{vite,eslint,drizzle}.config.{ts,js}\" \"tsconfig*.json\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"{package,components}.json\" \"{README,DESIGN}.md\" \"{vite,eslint,drizzle}.config.{ts,js}\" \"tsconfig*.json\"",
